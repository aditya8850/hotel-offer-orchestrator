{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Hotel Offer Orchestrator with Express, Temporal.io, Redis, and Docker Compose",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/temporal/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/temporal/worker.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --coverage --forceExit"
  },
  "keywords": [
    "temporal",
    "redis",
    "express",
    "typescript",
    "hotel-orchestrator"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
